{
  "terminal": {
    "fontFamily": "var(--font-mono)",
    "fontSize": 13,
    "fontWeight": "normal",
    "fontWeightBold": "bold",
    "lineHeight": 1,
    "letterSpacing": 0,
    "transparent": false,
    "opacity": 1,
    "background": "var(--bg-card)",
    "foreground": "var(--text-primary)",
    "cursor": "var(--accent)",
    "cursorAccent": "var(--bg-card)",
    "selectionBackground": "var(--accent-ring)",
    "window": {
      "background": "var(--bg-card)",
      "headerBackground": "var(--bg-card)",
      "borderColor": "var(--border-subtle)",
      "blur": 0
    }
  }
}
